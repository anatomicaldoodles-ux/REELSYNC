# Copy to .env and adjust.

# SQLite for local development. For Postgres, see README.
DATABASE_URL="file:./dev.db"

# Public URL of the site (shown on unlocked reports).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Razorpay (optional locally). Leave empty to run without payments.
# Test keys start with rzp_test_, live keys with rzp_live_.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Secret you choose when creating the webhook in the Razorpay dashboard.
RAZORPAY_WEBHOOK_SECRET=""

# Full report price, in the smallest currency unit (79900 = ₹799).
PRO_REPORT_PRICE_CENTS="79900"
PRO_REPORT_CURRENCY="inr"

# Maximum accepted gzipped report size in bytes.
MAX_REPORT_BYTES="26214400"

# Development only: shows a button that unlocks reports without paying.
ALLOW_DEV_UNLOCK="true"
