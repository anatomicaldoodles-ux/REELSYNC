// Prisma schema for ReelSync.
// Dev uses SQLite; switch `provider` to "postgresql" and the adapter in src/lib/db.ts for production.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

/// One analysis of a public Instagram profile. Free reports get the pro
/// sections stripped at read time.
model Report {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  /// Instagram username that was analysed (lower-case).
  username    String?
  /// Data provider that fetched the profile ("apify", "demo").
  provider    String    @default("demo")
  /// The snapshot this report was computed from.
  snapshotId  String?
  /// Hashed client IP, for per-day lookup limits.
  ipHash      String?
  /// "free" until a successful payment flips it to "pro".
  tier        String    @default("free")
  paidAt      DateTime?
  /// Email captured from Stripe Checkout, used for receipts / report recovery.
  email       String?
  /// Full ProfileReport JSON (all sections, free and pro).
  data        String
  /// Analyzer version that produced `data`, for future re-rendering decisions.
  analyzerVersion String
  /// Secret token that allows deleting the report without an account.
  deleteToken String    @unique @default(cuid())
  payments    Payment[]

  @@index([createdAt])
  @@index([ipHash, createdAt])
}

/// A fetched copy of a public profile. Serves as a short-lived cache and as
/// follower-history for growth charts.
model ProfileSnapshot {
  id         String   @id @default(cuid())
  username   String
  fetchedAt  DateTime @default(now())
  provider   String
  followers  Int
  following  Int
  postsCount Int
  /// Full PublicProfile JSON including recent posts.
  data       String

  @@index([username, fetchedAt])
}

model Payment {
  id                    String   @id @default(cuid())
  createdAt             DateTime @default(now())
  reportId              String
  report                Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  /// Payment provider, currently "razorpay" (or "dev" for development unlocks).
  provider              String   @default("razorpay")
  /// Provider-side order id (Razorpay order_id). One order per unlock attempt.
  providerOrderId       String   @unique
  /// Provider-side payment id once the payment succeeds.
  providerPaymentId     String?
  /// Amount in the smallest currency unit (cents).
  amount                Int
  currency              String
  /// "pending" | "paid" | "refunded"
  status                String   @default("pending")
  email                 String?

  @@index([reportId])
}
