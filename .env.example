# Copy to .env and adjust.

# SQLite for local development. For Postgres, see README.
DATABASE_URL="file:./dev.db"

# Public URL of the site (shown on unlocked reports).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Razorpay (optional locally). Leave empty to run without payments.
# Test keys start with rzp_test_, live keys with rzp_live_.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Secret you choose when creating the webhook in the Razorpay dashboard.
RAZORPAY_WEBHOOK_SECRET=""

# Full report price, in the smallest currency unit (79900 = ₹799).
PRO_REPORT_PRICE_CENTS="79900"
PRO_REPORT_CURRENCY="inr"

# Instagram data provider (Apify). Leave empty to use generated demo data.
# Get a token at https://console.apify.com/account/integrations
APIFY_TOKEN=""
# Actor to run, in owner~name form.
APIFY_ACTOR="apify~instagram-scraper"
# Recent posts to analyse per lookup (more posts = better stats, higher cost).
LOOKUP_POSTS_LIMIT="50"
# Reuse a fetched profile for this many hours before fetching again.
SNAPSHOT_TTL_HOURS="24"
# Lookups one visitor (IP) may start per day.
LOOKUPS_PER_IP_PER_DAY="15"
# Random string used to hash visitor IPs before storing them.
IP_HASH_SALT="change-me"

# Development only: shows a button that unlocks reports without paying.
ALLOW_DEV_UNLOCK="true"
